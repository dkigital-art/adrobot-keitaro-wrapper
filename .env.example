# Keitaro Admin API (учебный стенд)
KEITARO_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_API_KEY=your_api_key_here

# Опционально: дефолтные ID со стенда (если не заданы — ищутся по имени через API)
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836
KEITARO_DOMAIN_NAME=
KEITARO_GROUP_NAME=FORTESTS
KEITARO_TRAFFIC_SOURCE_NAME=FORTESTS

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./adrobot.db

# Приложение
APP_HOST=127.0.0.1
APP_PORT=8000
